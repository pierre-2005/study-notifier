# MLO Studio 3.5 - Google/Outlook calendar and server-backed PWA setup
# Fill in locally; do not commit this .env file to GitHub.
# For GitHub -> Portainer: paste these values into the existing stack's Environment variables.
# Reuse your EXISTING secrets; never regenerate them during an upgrade.

# REQUIRED: keep these values identical to your running MLO stack.
SESSION_SECRET=CHANGE_ME_RANDOM_48_BYTE_SECRET
APP_USERNAME=admin
APP_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Website and security
MLO_PUBLIC_URL=https://organizer.overvault.ca
MLO_CREDENTIAL_KEY=
MLO_LEGAL_CONTACT_EMAIL=
COOKIE_SECURE=true
TIMEZONE=America/Edmonton

# Provider credentials: one OAuth app per provider supports many linked user accounts
MLO_GOOGLE_CLIENT_ID=
MLO_GOOGLE_CLIENT_SECRET=
MLO_MS_CLIENT_ID=
MLO_MS_CLIENT_SECRET=

# Background calendar sync. No routine manual Sync button.
MLO_CALENDAR_AUTO_SYNC=true
MLO_CALENDAR_SYNC_MINUTES=10
MLO_CALENDAR_SYNC_BATCH_SIZE=3

# Notifications (optional; ntfy per-device topics can be set inside MLO)
NOTIFIER=ntfy
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=

# Internal container paths from docker-compose.yml: do not change volume mappings.
STUDY_NOTIFIER_DB=/data/study_notifier.db
MLO_ATTACHMENT_DIR=/data/mlo_uploads

# TZ is intentionally omitted: MLO uses TIMEZONE above.

# v3.7: keep the scheduler disabled in offline staging. AI extraction is opt-in.
MLO_SCHEDULER_ENABLED=true
MLO_OUTLINE_AI_ENABLED=false
MLO_OUTLINE_AI_MODEL=
OPENAI_API_KEY=
