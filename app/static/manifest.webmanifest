{
  "name": "My Life Organized",
  "short_name": "MLO",
  "description": "Tasks, projects, calendars and focus in one workspace.",
  "id": "/life",
  "start_url": "/life",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#526dca",
  "icons": [
    {
      "src": "/static/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Today",
      "url": "/life",
      "description": "View your dashboard"
    },
    {
      "name": "New event",
      "url": "/life/calendars/new",
      "description": "Create an event in MLO or connected calendars"
    },
    {
      "name": "Tasks",
      "url": "/life/tasks",
      "description": "Open your tasks"
    }
  ]
}
